CREATE TABLE dim_products (
    product_id          INT             NOT NULL PRIMARY KEY,
    sku_code            VARCHAR(50)     NOT NULL,
    product_name        VARCHAR(200)    NOT NULL,
    category_id         INT             NOT NULL,
    unit_cost_usd       DECIMAL(15,2)   NOT NULL DEFAULT 0.00,
